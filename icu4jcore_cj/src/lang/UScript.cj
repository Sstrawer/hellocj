, 0, 0, 42313 | LIMITED_USE, 0, 73728 | EXCLUSION, 0, 64976 | UNKNOWN, 66208 | EXCLUSION, 12363 | RECOMMENDED | LB_LETTERS, 6688 | LIMITED_USE | LB_LETTERS, 66176 | EXCLUSION, 67872 | EXCLUSION | RTL, 7258 | LIMITED_USE, 43312 | EXCLUSION, 43138 | LIMITED_USE, 120912 | EXCLUSION, 7043 | LIMITED_USE, 0, 43968 | LIMITED_USE, 67648 | EXCLUSION | RTL, 68352 | EXCLUSION | RTL, 69891 | LIMITED_USE, 44032 | RECOMMENDED, 69763 | EXCLUSION, 68312 | EXCLUSION | RTL, 68448 | EXCLUSION | RTL, 68495 | EXCLUSION | RTL, 0, 68416 | EXCLUSION | RTL, 2048 | EXCLUSION | RTL, 43648 | LIMITED_USE | LB_LETTERS, 0, 0, 42656 | LIMITED_USE, 42192 | LIMITED_USE, 0, 68192 | EXCLUSION | RTL, 92902 | EXCLUSION, 113696 | EXCLUSION, 66816 | EXCLUSION, 70421 | EXCLUSION, 0, 0, 124930 | EXCLUSION | RTL, 68000 | EXCLUSION | RTL, 68245 | EXCLUSION | RTL, 67734 | EXCLUSION | RTL, 67699 | EXCLUSION | RTL, 70334 | EXCLUSION, 71860 | EXCLUSION | CASED, 0, 0, 92751 | EXCLUSION, 111044 | EXCLUSION | LB_LETTERS, 70019 | EXCLUSION, 69840 | EXCLUSION, 71296 | EXCLUSION, 98857 | EXCLUSION | LB_LETTERS, 0, 82944 | EXCLUSION, 70152 | EXCLUSION, 70788 | EXCLUSION, 66871 | EXCLUSION, 69970 | EXCLUSION, 71447 | EXCLUSION | LB_LETTERS, 67828 | EXCLUSION | RTL, 71182 | EXCLUSION, 70287 | EXCLUSION, 72384 | EXCLUSION, 71054 | EXCLUSION, 125193 | LIMITED_USE | RTL | CASED, 72718 | EXCLUSION, 72818 | EXCLUSION, 70674 | LIMITED_USE, 66741 | LIMITED_USE | CASED, 23383 | RECOMMENDED | LB_LETTERS, 4370 | RECOMMENDED, 0, 72976 | EXCLUSION, 72284 | EXCLUSION, 72203 | EXCLUSION, 71691 | EXCLUSION, 73073 | LIMITED_USE, 73445 | EXCLUSION, 93760 | EXCLUSION | CASED, 68882 | LIMITED_USE | RTL, 69442 | EXCLUSION | RTL, 69401 | EXCLUSION | RTL, 69617 | EXCLUSION | RTL, 123144 | LIMITED_USE, 72142 | EXCLUSION, 123617 | LIMITED_USE, 69567 | EXCLUSION | RTL, 71948 | EXCLUSION, 101477 | EXCLUSION | LB_LETTERS, 69256 | EXCLUSION | RTL, 77797 | EXCLUSION, 69500 | EXCLUSION | RTL, 92860 | EXCLUSION, 123536 | EXCLUSION, 66946 | EXCLUSION | CASED, 73499 | EXCLUSION | LB_LETTERS, 124134 | EXCLUSION]

    static func getScriptProps(script: Int32): Int32 {
        if (0 <= script && script < Int32(SCRIPT_PROPS.size)) {
            return SCRIPT_PROPS[Int64(script)]
        } else {
            return 0
        }
    }
}


public class UScript_ScriptUsage <: Enum<UScript_ScriptUsage> {
    public static let NOT_ENCODED = UScript_ScriptUsage("NOT_ENCODED", 0)

    public static let UNKNOWN = UScript_ScriptUsage("UNKNOWN", 1)

    public static let EXCLUDED = UScript_ScriptUsage("EXCLUDED", 2)

    public static let LIMITED_USE = UScript_ScriptUsage("LIMITED_USE", 3)

    public static let ASPIRATIONAL = UScript_ScriptUsage("ASPIRATIONAL", 4)

    public static let RECOMMENDED = UScript_ScriptUsage("RECOMMENDED", 5)

    private static func _values(): Array<UScript_ScriptUsage> {
        return [UScript_ScriptUsage.NOT_ENCODED, UScript_ScriptUsage.UNKNOWN, UScript_ScriptUsage.EXCLUDED, UScript_ScriptUsage.LIMITED_USE, UScript_ScriptUsage.ASPIRATIONAL, UScript_ScriptUsage.RECOMMENDED]
    }

    private static let _VALUES = UScript_ScriptUsage._values()

    public static func values(): Array<UScript_ScriptUsage> {
        return _VALUES.clone()
    }

    public static func valueOf(name: String): UScript_ScriptUsage {
        return (TypeInfo.of<UScript_ScriptUsage>() as ClassTypeInfo).findStaticMemberVariable(name).getValue() as UScript_ScriptUsage
    }

    private init(_enum_name: String, _enum_ordinal: Int32) {
        super(_enum_name, _enum_ordinal)
    }
}
