    private static func getCodesFromLocale(locale: ULocale): Array<Int32> {
        let lang = locale.getLanguage()
        if (lang == "ja") {
            return [UScript.KATAKANA, UScript.HIRAGANA, UScript.HAN]
        }
        if (lang == "ko") {
            return [UScript.HANGUL, UScript.HAN]
        }
        let script = locale.getScript()
        if (lang == "zh" && script == "Hant") {
            return [UScript.HAN, UScript.BOPOMOFO]
        }
        if (Int32(script.size) != 0) {
            var scriptCode = UScript.getCodeFromName(script)
            if (scriptCode != UScript.INVALID_CODE) {
                if (scriptCode == UScript.SIMPLIFIED_HAN || scriptCode == UScript.TRADITIONAL_HAN) {
                    scriptCode = UScript.HAN
                }
                return [scriptCode]
            }
        }
        return None
    }

    private static func findCodeFromLocale(locale: ULocale): Array<Int32> {
        let result = getCodesFromLocale(locale)
        if (result.isSome()) {
            return result
        }
        let likely = ULocale.addLikelySubtags(locale)
        return getCodesFromLocale(likely)
    }

    public static func getCode(locale: Locale): Array<Int32> {
        return findCodeFromLocale(ULocale.forLocale(locale))
    }

    public static func getCode(locale: ULocale): Array<Int32> {
        return findCodeFromLocale(locale)
    }

    public static func getCode(nameOrAbbrOrLocale: String): Array<Int32> {
        var triedCode = false
        var lastSepPos = indexOfWrap(nameOrAbbrOrLocale.indexOf(UInt8(UInt32('_'))))
        if (lastSepPos < 0) {
            lastSepPos = indexOfWrap(nameOrAbbrOrLocale.indexOf(UInt8(UInt32('-'))))
        }
        if (lastSepPos < 0 || (lastSepPos == 3 && Int32(nameOrAbbrOrLocale.size) > 8) || (lastSepPos == 7 && Int32(nameOrAbbrOrLocale.size) == 11)) {
            let propNum = UCharacter.getPropertyValueEnumNoThrow(UProperty.SCRIPT, nameOrAbbrOrLocale)
            if (propNum != UProperty.UNDEFINED) {
                return [propNum]
            }
            triedCode = true
        }
        let scripts = findCodeFromLocale(ULocale(nameOrAbbrOrLocale))
        if (scripts.isSome()) {
            return scripts
        }
        if (!triedCode) {
            let propNum = UCharacter.getPropertyValueEnumNoThrow(UProperty.SCRIPT, nameOrAbbrOrLocale)
            if (propNum != UProperty.UNDEFINED) {
                return [propNum]
            }
        }
        return None
    }

    public static func getCodeFromName(nameOrAbbr: String): Int32 {
        let propNum = UCharacter.getPropertyValueEnumNoThrow(UProperty.SCRIPT, nameOrAbbr)
        return if (propNum == UProperty.UNDEFINED) { INVALID_CODE } else { propNum }
    }

    public static func getScript(codepoint: Int32): Int32 {
        if (codepoint >= UCharacter.MIN_VALUE & codepoint <= UCharacter.MAX_VALUE) {
            let scriptX = UCharacterProperty.INSTANCE.getAdditional(codepoint, 0) & UCharacterProperty.SCRIPT_X_MASK
            let codeOrIndex = UCharacterProperty.mergeScriptCodeOrIndex(scriptX)
            if (scriptX < UCharacterProperty.SCRIPT_X_WITH_COMMON) {
                return codeOrIndex
            } else if (scriptX < UCharacterProperty.SCRIPT_X_WITH_INHERITED) {
                return UScript.COMMON
            } else if (scriptX < UCharacterProperty.SCRIPT_X_WITH_OTHER) {
                return UScript.INHERITED
            } else {
                return Int32(UInt32(UCharacterProperty.INSTANCE.m_scriptExtensions_[Int64(codeOrIndex)]))
            }
        } else {
            throw IllegalArgumentException(codepoint.toString())
        }
    }

    public static func hasScript(c: Int32, sc: Int32): Bool {
        let scriptX = UCharacterProperty.INSTANCE.getAdditional(c, 0) & UCharacterProperty.SCRIPT_X_MASK
        let codeOrIndex = UCharacterProperty.mergeScriptCodeOrIndex(scriptX)
        if (scriptX < UCharacterProperty.SCRIPT_X_WITH_COMMON) {
            return sc == codeOrIndex
        }
        let scriptExtensions = UCharacterProperty.INSTANCE.m_scriptExtensions_
        var scx = codeOrIndex
        if (scriptX >= UCharacterProperty.SCRIPT_X_WITH_OTHER) {
            scx = Int32(UInt32(scriptExtensions[Int64(scx + 1)]))
        }
        if (sc > 32767) {
            return false
        }
        while (sc > Int32(UInt32(scriptExtensions[Int64(scx)]))) {
            scx++
        }
        return sc == (Int32(UInt32(scriptExtensions[Int64(scx)])) & 32767)
    }

    public static func getScriptExtensions(c: Int32, set: BitSet): Int32 {
        set.clear()
        let scriptX = UCharacterProperty.INSTANCE.getAdditional(c, 0) & UCharacterProperty.SCRIPT_X_MASK
        let codeOrIndex = UCharacterProperty.mergeScriptCodeOrIndex(scriptX)
        if (scriptX < UCharacterProperty.SCRIPT_X_WITH_COMMON) {
            set.set(codeOrIndex)
            return codeOrIndex
        }
        let scriptExtensions = UCharacterProperty.INSTANCE.m_scriptExtensions_
        var scx = codeOrIndex
        if (scriptX >= UCharacterProperty.SCRIPT_X_WITH_OTHER) {
            scx = Int32(UInt32(scriptExtensions[Int64(scx + 1)]))
        }
        var length = 0
        var sx: Int32 = 0
        return -length
    }

    public static func getName(scriptCode: Int32): String {
        return UCharacter.getPropertyValueName(UProperty.SCRIPT, scriptCode, UProperty_NameChoice.LONG)
    }

    public static func getShortName(scriptCode: Int32): String {
        return UCharacter.getPropertyValueName(UProperty.SCRIPT, scriptCode, UProperty_NameChoice.SHORT)
    }

    private static let usageValues = UScript_ScriptUsage.values()

    public static func getSampleString(script: Int32): String {
        let sampleChar = UScript_ScriptMetadata.getScriptProps(script) & 2097151
        if (sampleChar != 0) {
            return StringBuilder().appendCodePoint(sampleChar).toString()
        }
        return ""
    }

    public static func getUsage(script: Int32): UScript_ScriptUsage {
        return usageValues[Int64((shr(UScript_ScriptMetadata.getScriptProps(script), 21)) & 7)]
    }

    public static func isRightToLeft(script: Int32): Bool {
        return (UScript_ScriptMetadata.getScriptProps(script) & UScript_ScriptMetadata.RTL) != 0
    }

    public static func breaksBetweenLetters(script: Int32): Bool {
        return (UScript_ScriptMetadata.getScriptProps(script) & UScript_ScriptMetadata.LB_LETTERS) != 0
    }

    public static func isCased(script: Int32): Bool {
        return (UScript_ScriptMetadata.getScriptProps(script) & UScript_ScriptMetadata.CASED) != 0
    }

}


